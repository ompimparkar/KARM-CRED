# KARM CRED backend environment variables (all optional - defaults shown).
# Copy to .env, or set them in your shell / deploy platform's env settings.
# app.py reads these via os.environ; nothing is required for local dev.

# Comma-separated browser origins allowed by CORS. Add your LAN IP when the
# dashboard is opened from another device, e.g. http://10.87.166.240:5000
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# 1 enables Flask debug mode (local development ONLY - the debug console is
# a remote-code-execution surface; never expose it on a network/demo).
FLASK_DEBUG=0

# 1 serves the API over an ad-hoc HTTPS certificate (needs pyopenssl).
# Production must be HTTPS - see README "Security".
KARM_HTTPS=0

# Interface / port for the dev server (gunicorn ignores these; use the
# Procfile / platform settings for production).
KARM_HOST=0.0.0.0
KARM_PORT=5000
