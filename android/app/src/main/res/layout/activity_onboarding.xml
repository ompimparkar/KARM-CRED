<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KARM CRED"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#008080" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Where Your Daily Hustle Builds Your Credit"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="To evaluate your TrustScore without salary slips, we read specific data sources on this device. Choose exactly which ones you allow. This is purpose-bound consent under India's DPDP Act: you can change or revoke any grant later from the dashboard."
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Data sources you do NOT allow are never sent for scoring - the model only sees the sources you grant below."
            android:textSize="13sp"
            android:textStyle="italic"
            android:textColor="#555555" />

        <CheckBox
            android:id="@+id/chkUpi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="UPI &amp; bank SMS metadata (payment frequency, on-time behaviour)"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/chkUtility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Utility bill reminders (electricity / phone bill punctuality)"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/chkPlatform"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Gig platform profile &amp; ratings (average rating, rating trend)"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="In production this consent flow rides India's Account Aggregator framework for UPI/bank data; this demo simulates on-device SMS parsing instead. No chat data is ever read."
            android:textSize="12sp"
            android:textColor="#777777"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/btnGrantSelected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Continue With Selected Sources"
            android:backgroundTint="#008080" />

        <Button
            android:id="@+id/btnGrantAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Allow All &amp; Calculate Score"
            android:backgroundTint="#008080" />
    </LinearLayout>
</ScrollView>
