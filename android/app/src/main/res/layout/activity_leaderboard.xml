<?xml version="1.0" encoding="utf-8"?>
<!-- Gigs Leaderboard: three segments + card list with reason bars, GRID6
     skeleton while loading, empty/error art + retry, particle background. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <com.example.karmcredapp.NetworkBgView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnLbTop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Top"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLbMiddle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Building"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLbBottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Support"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- empty / error block: illustration + message + retry -->
        <LinearLayout
            android:id="@+id/lbErrorBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_empty_state" />

            <TextView
                android:id="@+id/tvLbState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Loading leaderboard…"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnLbRetry"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Retry"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- pulsing skeleton while the leaderboard loads -->
        <com.example.karmcredapp.SkeletonView
            android:id="@+id/lbSkeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLeaderboard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvLbMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text=""
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <include layout="@layout/view_bottom_nav" />
    </LinearLayout>
</FrameLayout>
